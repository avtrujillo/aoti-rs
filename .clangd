CompileFlags:
  # Relative -I paths resolve against the source file's directory, and all
  # C++ sources live in csrc/, hence the ../ prefixes.  target/cxxbridge and
  # target/libtorch are symlinks maintained by build.rs
  Add:
    - -xc++
    - --std=c++17
    - -I../target/cxxbridge
    - -I../target/libtorch/include
    - -I../target/libtorch/include/torch/csrc/api/include
    - -I..
